# 复制成 .env 即可生效（真实环境变量优先级高于本文件）。
# 只列常用项，全部环境变量见 README。

# ---------- 数据库 ----------
# 方式一：给整条 DSN（优先级最高）
# GATEWAY_DB_DSN=postgres://gateway:gateway@127.0.0.1:5432/gateway?sslmode=disable&TimeZone=Asia/Shanghai
# 方式二：给分量，改密码不用重写整条 URL
GATEWAY_DB_HOST=127.0.0.1
GATEWAY_DB_PORT=5432
GATEWAY_DB_USER=gateway
GATEWAY_DB_PASSWORD=gateway
GATEWAY_DB_NAME=gateway
GATEWAY_DB_SSLMODE=disable
GATEWAY_DB_TIMEZONE=Asia/Shanghai
# 连接池上限，别超过 PG 的 max_connections（默认 100）
GATEWAY_DB_MAX_OPEN=32
GATEWAY_DB_MAX_IDLE=8

# ---------- 服务 ----------
GATEWAY_PORT=8080
# 数据目录：只放请求/响应原文归档（原文不进数据库，方便单独冷备/迁对象存储）
GATEWAY_DATA_DIR=./data
# 生产必须改
GATEWAY_JWT_SECRET=dev-insecure-secret-change-me
GATEWAY_ADMIN_USER=admin
GATEWAY_ADMIN_PASS=admin
GATEWAY_ALLOW_REGISTER=true
# 异步落库队列容量：满了丢日志、不阻塞转发（丢弃数在概览页可见）
GATEWAY_LOG_QUEUE_SIZE=32768

# ---------- 测试 ----------
# go test 需要一个真 PG（测试会在里面建独立 schema，跑完删掉）
GATEWAY_TEST_DSN=postgres://gateway:gateway@127.0.0.1:5432/gateway_test?sslmode=disable
